# Model provider
DEEPSEEK_API_KEY=sk-your-key-here
# Optional
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Accounts. `npm run setup` writes a random AUTH_SECRET to .env.local for you.
# Signs sessions, login codes and save tickets. At least 32 characters. Changing it signs everyone out
# and invalidates every save ticket (chats stay in the browsers, story progress restarts).
AUTH_SECRET=
# Comma separated emails allowed to generate stories. Empty means nobody is admin.
ADMIN_EMAILS=you@example.com
# Set to the public origin in production, e.g. https://drama.example.com. Unset: the Host header is used.
# APP_ORIGIN=
# Where the database and generated stories live. Default: ./data
# DATA_DIR=

# Login emails (Resend). Unset in development: the code is printed in the server log instead.
# Unset in production: sign-in answers 503.
# RESEND_API_KEY=
# MAIL_FROM=Drama Chat <login@example.com>

# Limits
# DAILY_MESSAGE_CAP=200
# DAY_TZ=Asia/Ho_Chi_Minh

# Production on Snow (docker compose). See README "Deploy to Snow".
# Cloudflare Tunnel token for the cloudflared sidecar (docker compose only).
TUNNEL_TOKEN=
# Public origin (placeholder shown; set your real one in the server's .env).
# APP_ORIGIN=https://your-domain.example
# Provider keys (see contracts): ARK_API_KEY, ARK_CHAT_MODEL, ARK_BASE_URL
# ARK_API_KEY=
# ARK_CHAT_MODEL=
# Host user for the data folder, if not 1000:1000
# APP_UID=1000
# APP_GID=1000
