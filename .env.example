# Model providers. ByteDance (BytePlus ModelArk) is the primary, DeepSeek the backup. Set one or both.
# ByteDance counts as configured only when BOTH the key and ARK_CHAT_MODEL are set.
# ARK_API_KEY=
# ARK_CHAT_MODEL=   # model id from the ModelArk console
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3   # China console (Volcano Engine Ark): set its base URL
# ARK_STORY_MODEL=      # default: ARK_CHAT_MODEL
# ARK_JUDGE_MODEL=      # judge, speaker picker and story guide; default: ARK_CHAT_MODEL
# ARK_THINKING=disabled # disabled | enabled | auto | omit (omit sends no "thinking" field)
# ARK_JSON_MODE=json_object   # json_object | none (none sends no response_format)
# bytedance | deepseek: which configured provider goes first
# LLM_PRIMARY=bytedance
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Accounts. `npm run setup` writes a random AUTH_SECRET to .env.local for you.
# Signs sessions, login codes and save tickets. At least 32 characters. Changing it signs everyone out
# and invalidates every save ticket (chats stay in the browsers, story progress restarts).
AUTH_SECRET=
# Comma separated emails allowed to generate stories. Empty means nobody is admin.
ADMIN_EMAILS=you@example.com
# Set to the public origin in production, e.g. https://drama.example.com. Unset: the Host header is used.
# APP_ORIGIN=
# Where the database and generated stories live. Default: ./data
# DATA_DIR=

# Login emails (Resend). Unset in development: the code is printed in the server log instead.
# Unset in production: sign-in answers 503.
# RESEND_API_KEY=
# MAIL_FROM=Drama Chat <login@example.com>

# Limits
# DAILY_MESSAGE_CAP=200
# DAY_TZ=Asia/Ho_Chi_Minh
# Story guides per user per day before an ad is needed.
# GUIDE_FREE_PER_DAY=1
# Seconds an ad session must be open (server clock) before it can be completed.
# AD_MIN_SECONDS=15
# Completed ads per user per day, items and guides together.
# AD_DAILY_CAP=10

# Production on Snow (docker compose). See README "Deploy to Snow".
# Cloudflare Tunnel token for the cloudflared sidecar (docker compose only).
TUNNEL_TOKEN=
# Public origin (placeholder shown; set your real one in the server's .env).
# APP_ORIGIN=https://your-domain.example
# Host user for the data folder, if not 1000:1000
# APP_UID=1000
# APP_GID=1000
